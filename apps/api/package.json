{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "bun run --hot --port 3003 src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bumps/floor-model": "workspace:*",
    "@google/adk": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "image-size": "^2.0.2",
    "manifold-3d": "^3.5.1",
    "mupdf": "^1.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5"
  }
}
