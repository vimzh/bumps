# Gemini access — one of the two:
# 1) AI Studio API key (simplest for local dev):
GEMINI_API_KEY=
# 2) Vertex AI via gcloud ADC (for a GCP deployment):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Model tiers (defaults shown)
# MODEL_CRITICAL=gemini-3.7-flash
# MODEL_FAST=gemini-3.7-flash

# OpenRouter test route (direct Gemini remains the default):
# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# MODEL_CRITICAL=google/gemini-3.7-flash
# MODEL_FAST=google/gemini-3.7-flash
# MODEL_LAYOUT=google/gemini-3.7-flash
# MODEL_COMPARE=google/gemini-3.7-flash

# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bumps
# UPLOADS_DIR=data/uploads
